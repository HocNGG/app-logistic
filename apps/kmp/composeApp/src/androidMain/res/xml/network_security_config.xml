<?xml version="1.0" encoding="utf-8"?>
<!--
  =====================================================================================
  NETWORK SECURITY CONFIG — CHỈ DÙNG CHO MÁY CHỦ THỬ NGHIỆM.

  VÌ SAO TỆP NÀY TỒN TẠI (bài học thật, 2026-10-28):
  Trên máy ảo Android 17 (API 37, targetSdk 37), app bấm "Đăng nhập" chỉ hiện câu
  "Không kết nối được Odoo ở http://10.0.2.2:8069 …" và log Odoo KHÔNG có request nào —
  tức là request chưa ra khỏi app. Một trong các nguyên nhân khả dĩ là chính sách cleartext:
  OkHttp kiểm tra chính sách này TRƯỚC khi mở socket, nên bị chặn là "không có request" đúng
  như quan sát. Cờ `android:usesCleartextTraffic="true"` trong manifest là cách cũ; cách được
  hệ điều hành ưu tiên (và ghi đè mọi cấu hình khác) là khai báo TƯỜNG MINH ở đây.

  Nội dung:
   - `base-config cleartextTrafficPermitted="true"`: cho phép HTTP thường cho mọi host —
     chấp nhận được vì đây là bản demo nội bộ, chạy trên máy ảo.
   - `domain-config` khai riêng `10.0.2.2` (loopback máy host nhìn từ máy ảo), `localhost`,
     `127.0.0.1`: những địa chỉ CHỈ dùng để thử nghiệm, kèm comment để người review thấy rõ
     phạm vi.
   - `trust-anchors` = chứng chỉ hệ thống: giữ nguyên hành vi TLS mặc định cho HTTPS thật
     (không hạ chuẩn bảo mật của kênh HTTPS, chỉ mở riêng HTTP).

  ⚠️ KHÔNG dùng cấu hình này cho bản phát hành thật: khi lên production phải bỏ
  `cleartextTrafficPermitted="true"` và chỉ giữ máy chủ HTTPS.
  =====================================================================================
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Chỉ ba địa chỉ thử nghiệm. Khai tường minh để đọc là hiểu, không phải suy luận. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
