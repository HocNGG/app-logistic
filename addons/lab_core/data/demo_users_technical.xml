        <function model="res.users" name="_lab_bo_nhom_ky_thuat" eval="[[ref('demo_user_cs'), ref('demo_user_kho'), ref('demo_user_chungtu'), ref('demo_user_ketoan'), ref('demo_user_manager'), ref('demo_user_sep'), ref('demo_user_nhomtruong')]]"/>

